rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function udoc() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasUser() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasUser() && udoc().role == 'admin'; }
    function active() { return hasUser() && udoc().status == 'active'; }

    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && request.resource.data.status == 'active';
      allow update: if isAdmin() || (signed() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last']));
      allow delete: if isAdmin();
    }
    match /posts/{id} {
      allow read: if resource.data.status in ['approved', 'returned']
                  || (signed() && resource.data.owner == request.auth.uid) || isAdmin();
      allow create: if active() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
    match /private/{id} {
      allow read: if signed() && (resource.data.owner == request.auth.uid || isAdmin());
      allow create: if active() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /claims/{id} {
      allow read: if signed() && (resource.data.by == request.auth.uid || isAdmin());
      allow create: if active() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /notifications/{id} {
      allow read: if signed() && (resource.data.to == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin() || (signed() && resource.data.to == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin() || (signed() && resource.data.to == request.auth.uid);
    }
    match /delreqs/{id} {
      allow read: if signed() && (resource.data.by == request.auth.uid || isAdmin());
      allow create: if active() && request.resource.data.by == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
  }
}
